# Copy to .env on the host (never commit .env). Read by docker-compose.yml.

# Sign-in for the web UI. The app stays locked (503) while ADMIN_PASSWORD is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the login cookie. Generate with: openssl rand -hex 32
# If left empty the app creates one in data/.secret_key (also untracked).
SECRET_KEY=

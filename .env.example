# Copy to .env on the host (never commit .env). Read by docker-compose.yml.

# Sign-in for the web UI. The app stays locked (503) while ADMIN_PASSWORD is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional extra sign-ins: user:password pairs separated by ';' (passwords must not contain ';').
# Example: ADMIN_USERS=alice:S3cretOne;bob:S3cretTwo
ADMIN_USERS=

# Signs the login cookie. Generate with: openssl rand -hex 32
# If left empty the app creates one in data/.secret_key (also untracked).
SECRET_KEY=

# Name of the login cookie (default peplink_session). Only change it if another app on the same host name uses it.
SESSION_COOKIE_NAME=

# The login cookie is marked Secure (sent over HTTPS only). Set to 0 ONLY if you open the app over plain http://
# from another machine (http://localhost works without it in most browsers). Leave 1 behind HTTPS.
SESSION_COOKIE_SECURE=1

# Number of reverse proxies in front of the app (0 = none, the default). Set it (e.g. 1) when the app is reached through a
# proxy / HTTPS front end, so the failed-login lockout counts each client's real address instead of the proxy's.
# Only set it if a proxy really is in front: otherwise a client could fake its address.
TRUSTED_PROXIES=0
